<configuration>
    <!--
        Without this file logback logs everything at DEBUG, and the Jetty client used for the
        Dojo/Whirlpool connection dumps whole HTTP requests, including the Dojo API key, to the
        console and to any log the user saves or shares. Keep third-party transports at WARN.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.squareup.okhttp" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
