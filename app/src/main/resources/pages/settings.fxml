                                            </font>
                                        </Label>
                                        <Button fx:id="rendezvousButton" mnemonicParsing="false" onAction="#onShowRendezvousPeersClick" prefWidth="132.0" text="Manage..." />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </GridPane>
            </content>
        </ScrollPane>
    </children>
</GridPane>
