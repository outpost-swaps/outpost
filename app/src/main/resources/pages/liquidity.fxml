                <VBox fx:id="progressBox" alignment="CENTER" spacing="14.0" managed="false" visible="false" VBox.vgrow="ALWAYS">
                    <ProgressIndicator fx:id="progressIndicator" maxHeight="88.0" maxWidth="88.0" prefHeight="88.0" prefWidth="88.0" progress="-1.0" />
                    <Label fx:id="startupStatus" textFill="#919191" wrapText="true" textAlignment="CENTER" alignment="CENTER" maxWidth="460.0" />
                </VBox>
                <VBox fx:id="offlineBox" alignment="CENTER" managed="false" spacing="10.0" visible="false" VBox.vgrow="ALWAYS">
                    <Label alignment="CENTER" text="Automated Swap Backend (ASB) is not running" textAlignment="CENTER" textFill="WHITE">
                        <font>
                            <Font name="Arial Bold" size="32.0" />
                        </font>
                    </Label>
                    <Label alignment="CENTER" text="Start it here, or tick “Start selling Monero” on the unlock screen. It sells your Monero to buyers as a market maker." textAlignment="CENTER" textFill="#9aa0a6" wrapText="true">
                        <font>
                            <Font size="14.0" />
                        </font>
                        <VBox.margin>
                            <Insets left="120.0" right="120.0" />
                        </VBox.margin>
                    </Label>
                    <Button fx:id="startAsbButton" onAction="#onStartAsbClick" text="Start ASB" styleClass="dialog-button-danger" />
                </VBox>
            </children>
        </VBox>
    </children>
</GridPane>
