<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.fxmisc.flowless.*?>
<?import org.fxmisc.richtext.*?>

<GridPane fx:id="mainPane" alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="swap.gui.controller.MainController">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <!-- Nav and logs rows are PINNED (min=pref=max): the logs VBox's
             minimum grows as log lines accumulate (VirtualizedScrollPane has
             a content-driven min), and an unpinned row follows it — which
             shifted the nav bar by a different amount per tab. Pinned rows
             cannot move; the content row takes the constant remainder. -->
        <RowConstraints minHeight="52.0" prefHeight="52.0" maxHeight="52.0" />
        <RowConstraints vgrow="ALWAYS" />
        <RowConstraints minHeight="200.0" prefHeight="200.0" maxHeight="200.0" />
    </rowConstraints>
    <children>
<!--        <Label text="This user interface is a beta development/testing UI. The final UI is still in development. Start with small trades to test and get comfortable with the process." textFill="#ff9500">-->
<!--            <font>-->
<!--                <Font name="System Bold" size="13.0" />-->
<!--            </font>-->
<!--            <padding>-->
<!--                <Insets bottom="4.0" left="2.0" right="2.0" top="4.0" />-->
<!--            </padding>-->
<!--        </Label>-->
        <HBox fx:id="navBar" alignment="CENTER_LEFT" GridPane.rowIndex="0">
            <children>
                <Button fx:id="swapsNav" focusTraversable="false" maxHeight="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#swapsPage" prefHeight="40.0" prefWidth="110.0" text="Swaps">
                    <HBox.margin>
                        <Insets right="1.0" />
                    </HBox.margin>
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="EXCHANGE" size="10">
                            <font>
                                <Font name="Arial Bold" size="14.0" />
                            </font>
                        </FontAwesomeIconView>
                    </graphic>
                    <font>
                        <Font name="Arial Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="liquidityNav" focusTraversable="false" maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#liquidityPage" prefHeight="40.0" prefWidth="110.0" text="Liquidity">
                    <HBox.margin>
                        <Insets right="1.0" />
                    </HBox.margin>
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="BANK" size="10">
                            <font>
                                <Font name="Arial Bold" size="14.0" />
                            </font>
                        </FontAwesomeIconView>
                    </graphic>
                </Button>
                <Button fx:id="historyNav" focusTraversable="false" maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#historyPage" prefHeight="40.0" prefWidth="110.0" text="History">
                    <HBox.margin>
                        <Insets right="1.0" />
                    </HBox.margin>
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="LIST" size="10">
                            <font>
                                <Font name="Arial Bold" size="14.0" />
                            </font>
                        </FontAwesomeIconView>
                    </graphic>
                    <font>
                        <Font name="Arial Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="withdrawNav" focusTraversable="false" maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#withdrawPage" prefHeight="40.0" prefWidth="110.0" text="Withdraw">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="SEND" size="10">
                            <font>
                                <Font name="Arial Bold" size="14.0" />
                            </font>
                        </FontAwesomeIconView>
                    </graphic>
                    <font>
                        <Font name="Arial Bold" size="13.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="1.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="settingsNav" focusTraversable="false" maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#settingsPage" prefHeight="40.0" prefWidth="110.0" text="Settings">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="COG" size="10">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </FontAwesomeIconView>
                    </graphic>
                </Button>

                <ImageView fx:id="torImage" fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                    <image>
                        <Image url="@images/tor.png" />
                    </image>
                    <viewport>
                        <Rectangle2D width="256.0" />
                    </viewport>
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </ImageView>

                <FontAwesomeIconView fx:id="dojoStatusIcon" fill="#888888" glyphName="DATABASE" size="16">
                    <HBox.margin><Insets left="6.0" /></HBox.margin>
                </FontAwesomeIconView>

                <ImageView fx:id="whirlpoolImage" fitHeight="20.0" fitWidth="20.0" preserveRatio="true" visible="false" managed="false">
                    <image>
                        <Image url="@images/whirlpool-logo.png" />
                    </image>
                    <viewport>
                        <Rectangle2D width="256.0" />
                    </viewport>
                    <HBox.margin>
                        <Insets left="6.0" />
                    </HBox.margin>
                </ImageView>

                <FontAwesomeIconView fx:id="asbIcon" fill="WHITE" glyphName="BULLSEYE" size="20" visible="false" managed="false">
                    <HBox.margin>
                        <Insets left="6.0" />
                    </HBox.margin>
                </FontAwesomeIconView>

                <Region HBox.hgrow="ALWAYS" />

                <HBox fx:id="navSpotPriceChip" alignment="CENTER" visible="false" style="-fx-background-color: #171717; -fx-background-radius: 4; -fx-border-color: #8f1a14; -fx-border-radius: 4; -fx-padding: 3 10 4 10;">
                    <children>
                        <VBox alignment="CENTER_LEFT" spacing="0.0">
                            <children>
                                <Label text="XMR SPOT" textFill="#9aa0a6">
                                    <font>
                                        <Font name="Arial Bold" size="9.0" />
                                    </font>
                                </Label>
                                <Label fx:id="navSpotPriceText" text="—" textFill="#e7eaf0">
                                    <font>
                                        <Font name="Menlo" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <HBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </HBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
            </padding>
         <GridPane.margin>
            <Insets />
         </GridPane.margin>
        </HBox>
        <AnchorPane fx:id="contentPane" GridPane.rowIndex="1">
            <children>
            </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
        </AnchorPane>
        <VBox fx:id="logsView" GridPane.rowIndex="2">
            <Label text="Logs" textFill="#c0201a">
                <font>
                    <Font name="Arial Bold" size="14.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="6.0" />
                </VBox.margin>
            </Label>

            <VirtualizedScrollPane fx:id="vScrollPane" VBox.vgrow="ALWAYS" >
                <content>
                    <InlineCssTextArea fx:id="logs" editable="false" wrapText="true" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                        </padding>
                    </InlineCssTextArea>
                </content>
            </VirtualizedScrollPane>
          <padding>
             <Insets bottom="10.0" left="10.0" right="10.0" />
          </padding>
        </VBox>
    </children>
</GridPane>
