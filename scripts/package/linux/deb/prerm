#!/bin/sh
# prerm script for outpost
# Removing the menu entry is best effort: a failure here must not stop the package from being removed.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        xdg-desktop-menu uninstall /opt/outpost/lib/outpost-Outpost.desktop >/dev/null 2>&1 || true
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
